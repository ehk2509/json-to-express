{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ehk2509/json-to-express/schema/application.schema.json",
  "title": "json-to-express application specification",
  "type": "object",
  "required": [
    "app",
    "database",
    "entities"
  ],
  "properties": {
    "generation": {
      "type": "object",
      "properties": {
        "outputDir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "app": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3000
        },
        "portEnv": {
          "type": "string",
          "minLength": 1,
          "default": "PORT"
        },
        "apiPrefix": {
          "type": "string",
          "pattern": "^/",
          "default": "/api"
        },
        "bodyLimit": {
          "type": [
            "string",
            "number"
          ],
          "default": "1mb"
        },
        "health": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "path": {
              "type": "string",
              "pattern": "^/",
              "default": "/health"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599,
              "default": 200
            },
            "response": {}
          }
        },
        "responses": {
          "type": "object",
          "properties": {
            "notFound": {
              "type": "string"
            },
            "validationError": {
              "type": "string"
            },
            "invalidIdentifier": {
              "type": "string"
            },
            "uniqueConstraint": {
              "type": "string"
            },
            "internalError": {
              "type": "string"
            }
          }
        },
        "statusCodes": {
          "type": "object",
          "properties": {
            "notFound": {
              "$ref": "#/$defs/httpStatus"
            },
            "validationError": {
              "$ref": "#/$defs/httpStatus"
            },
            "invalidIdentifier": {
              "$ref": "#/$defs/httpStatus"
            },
            "uniqueConstraint": {
              "$ref": "#/$defs/httpStatus"
            },
            "internalError": {
              "$ref": "#/$defs/httpStatus"
            }
          }
        },
        "package": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "private": {
              "type": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "nodeEngine": {
              "type": "string",
              "minLength": 1
            },
            "scripts": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "dependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "devDependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "mongodb"
        },
        "uriEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "default": "MONGODB_URI"
        },
        "defaultUri": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object"
        }
      }
    },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "httpStatus": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "operation": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "method": {
              "enum": [
                "get",
                "post",
                "put",
                "patch",
                "delete"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "status": {
              "$ref": "#/$defs/httpStatus"
            },
            "notFoundStatus": {
              "$ref": "#/$defs/httpStatus"
            },
            "lean": {
              "type": "boolean"
            },
            "runValidators": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "date"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "minLength": {
          "type": "number"
        },
        "maxLength": {
          "type": "number"
        },
        "default": {},
        "options": {
          "type": "object"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "fields"
      ],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "collection": {
          "type": "string",
          "minLength": 1
        },
        "idParam": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "schemaOptions": {
          "type": "object"
        },
        "operations": {
          "type": "object",
          "properties": {
            "list": {
              "$ref": "#/$defs/operation"
            },
            "get": {
              "$ref": "#/$defs/operation"
            },
            "create": {
              "$ref": "#/$defs/operation"
            },
            "update": {
              "$ref": "#/$defs/operation"
            },
            "delete": {
              "$ref": "#/$defs/operation"
            }
          }
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    }
  }
}
