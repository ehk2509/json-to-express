{
  "specVersion": "1.0",
  "app": {
    "name": "p9-helpdesk",
    "framework": "express"
  },
  "database": {
    "type": "mongodb"
  },
  "entities": {
    "Ticket": {
      "fields": {
        "subject": {
          "type": "string",
          "required": true
        },
        "status": {
          "type": "string",
          "required": true
        },
        "priority": {
          "type": "number"
        },
        "resolved": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
