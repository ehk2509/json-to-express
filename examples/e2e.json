{
  "specVersion": "1.0",
  "generation": {
    "outputDir": ".tmp/e2e-app"
  },
  "app": {
    "name": "j2e-e2e",
    "port": 3456,
    "host": "127.0.0.1",
    "apiPrefix": "/api",
    "health": {
      "enabled": true,
      "path": "/health",
      "status": 200,
      "response": {
        "status": "ok"
      }
    }
  },
  "database": {
    "type": "mongodb",
    "uriEnv": "MONGODB_URI",
    "defaultUri": "mongodb://127.0.0.1:27017/j2e_e2e"
  },
  "entities": {
    "Product": {
      "operations": {
        "list": {
          "query": {
            "filters": [
              "name"
            ],
            "sortParam": "sort",
            "selectParam": "fields",
            "pagination": {
              "enabled": true,
              "defaultLimit": 20,
              "maxLimit": 100
            }
          }
        }
      },
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "options": {
            "trim": true
          }
        },
        "price": {
          "type": "number",
          "required": true,
          "min": 0
        }
      }
    }
  }
}
