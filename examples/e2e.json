{
  "specVersion": "1.0",
  "generation": {
    "outputDir": ".tmp/e2e-app"
  },
  "app": {
    "name": "j2e-e2e",
    "port": 3456,
    "host": "127.0.0.1",
    "apiPrefix": "/api",
    "health": {
      "enabled": true,
      "path": "/health",
      "status": 200,
      "response": {
        "status": "ok"
      }
    },
    "production": {
      "requestId": true,
      "securityHeaders": true
    }
  },
  "docs": {
    "openapi": {
      "enabled": true,
      "file": "openapi.json",
      "title": "J2E E2E",
      "version": "1.0.0"
    }
  },
  "database": {
    "type": "mongodb",
    "uriEnv": "MONGODB_URI",
    "defaultUri": "mongodb://127.0.0.1:27017/j2e_e2e"
  },
  "entities": {
    "Category": {
      "indexes": [
        {
          "fields": {
            "name": 1
          },
          "options": {
            "unique": true
          }
        }
      ],
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "unique": true
        }
      }
    },
    "Product": {
      "softDelete": {
        "enabled": true,
        "field": "deletedAt"
      },
      "indexes": [
        {
          "fields": {
            "name": 1,
            "price": -1
          },
          "options": {}
        }
      ],
      "operations": {
        "list": {
          "populate": [
            "category"
          ],
          "query": {
            "filters": [
              "name",
              "price"
            ],
            "operators": [
              "eq",
              "gte",
              "lte"
            ],
            "sortParam": "sort",
            "selectParam": "fields",
            "pagination": {
              "enabled": true,
              "defaultLimit": 20,
              "maxLimit": 100
            }
          }
        },
        "get": {
          "populate": [
            "category"
          ]
        }
      },
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "options": {
            "trim": true
          }
        },
        "price": {
          "type": "number",
          "required": true,
          "min": 0
        },
        "category": {
          "type": "reference",
          "ref": "Category",
          "required": true,
          "onDelete": "restrict"
        },
        "published": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "events": {
    "product.published": {
      "webhooks": [
        {
          "urlEnv": "TEST_WEBHOOK_URL",
          "method": "post",
          "failure": "fail"
        }
      ]
    },
    "product.repriced": {
      "webhooks": []
    }
  },
  "workflows": {
    "publishProduct": {
      "steps": [
        {
          "name": "load",
          "action": "findById",
          "entity": "Product",
          "id": "$params.id"
        },
        {
          "name": "update",
          "action": "updateById",
          "entity": "Product",
          "id": "$params.id",
          "data": {
            "published": true
          }
        },
        {
          "name": "event",
          "action": "emit",
          "event": "product.published",
          "payload": {
            "id": "$steps.update._id",
            "name": "$steps.update.name",
            "published": "$steps.update.published"
          }
        },
        {
          "name": "response",
          "action": "respond",
          "status": 200,
          "body": {
            "id": "$steps.update._id",
            "published": "$steps.update.published"
          }
        }
      ]
    },
    "repriceProduct": {
      "steps": [
        {
          "name": "update",
          "action": "updateById",
          "entity": "Product",
          "id": "$body.id",
          "data": {
            "price": "$body.price"
          }
        },
        {
          "name": "event",
          "action": "emit",
          "event": "product.repriced",
          "payload": {
            "id": "$steps.update._id",
            "price": "$steps.update.price"
          }
        }
      ]
    },
    "queueReprice": {
      "steps": [
        {
          "name": "job",
          "action": "enqueue",
          "job": "repriceProduct",
          "payload": {
            "id": "$params.id",
            "price": "$body.price"
          },
          "delayMs": 50
        },
        {
          "name": "response",
          "action": "respond",
          "status": 202,
          "body": {
            "queued": true
          }
        }
      ]
    }
  },
  "endpoints": {
    "publishProduct": {
      "method": "post",
      "path": "/products/:id/publish",
      "workflow": "publishProduct",
      "status": 200
    },
    "queueReprice": {
      "method": "post",
      "path": "/products/:id/reprice",
      "workflow": "queueReprice",
      "status": 202
    }
  },
  "outbox": {
    "worker": "embedded",
    "pollIntervalMs": 100,
    "batchSize": 10,
    "lockTimeoutMs": 5000,
    "maxAttempts": 4,
    "backoffMs": 100
  },
  "jobs": {
    "repriceProduct": {
      "workflow": "repriceProduct",
      "queue": "products",
      "maxAttempts": 3,
      "backoffMs": 100
    }
  }
}
