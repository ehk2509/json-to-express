{
  "specVersion": "1.0",
  "generation": {
    "outputDir": ".tmp/e2e-postgres"
  },
  "app": {
    "name": "j2e-postgres-e2e",
    "port": 3457,
    "host": "127.0.0.1",
    "apiPrefix": "/api",
    "health": {
      "enabled": true,
      "path": "/health",
      "status": 200,
      "response": {
        "status": "ok"
      }
    },
    "production": {
      "requestId": true,
      "securityHeaders": true
    }
  },
  "docs": {
    "openapi": {
      "enabled": true,
      "file": "openapi.json",
      "title": "J2E PostgreSQL E2E",
      "version": "1.0.0"
    }
  },
  "database": {
    "type": "postgresql",
    "uriEnv": "DATABASE_URL",
    "defaultUri": "postgresql://postgres:postgres@127.0.0.1:5432/j2e_postgres",
    "idStrategy": "uuid",
    "prisma": {
      "schemaPath": "prisma/schema.prisma"
    }
  },
  "entities": {
    "Category": {
      "collection": "categories",
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "unique": true
        }
      }
    },
    "Product": {
      "collection": "products",
      "softDelete": {
        "enabled": true,
        "field": "deletedAt"
      },
      "indexes": [
        {
          "fields": {
            "name": 1,
            "price": -1
          },
          "options": {}
        }
      ],
      "operations": {
        "list": {
          "populate": [
            "category",
            "tags"
          ],
          "query": {
            "filters": [
              "name",
              "price",
              "category",
              "tags"
            ],
            "operators": [
              "eq",
              "gte",
              "lte"
            ],
            "sortParam": "sort",
            "selectParam": "fields",
            "pagination": {
              "enabled": true,
              "defaultLimit": 20,
              "maxLimit": 100
            }
          },
          "cache": {
            "enabled": true,
            "ttlSeconds": 120
          }
        },
        "get": {
          "populate": [
            "category",
            "tags"
          ],
          "cache": {
            "enabled": true,
            "ttlSeconds": 120
          }
        },
        "update": {
          "transaction": true,
          "populate": [
            "tags"
          ]
        },
        "create": {
          "populate": [
            "tags"
          ]
        }
      },
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "minLength": 2
        },
        "price": {
          "type": "number",
          "required": true,
          "min": 0
        },
        "category": {
          "type": "reference",
          "ref": "Category",
          "required": true,
          "onDelete": "restrict"
        },
        "published": {
          "type": "boolean",
          "default": false
        },
        "tags": {
          "type": "reference",
          "ref": "Tag",
          "many": true,
          "onDelete": "nullify"
        },
        "image": {
          "type": "file",
          "upload": {
            "maxBytes": 1024,
            "mimeTypes": [
              "text/plain"
            ],
            "directory": "products/images",
            "preserveExtension": true
          }
        },
        "attachments": {
          "type": "file",
          "many": true,
          "upload": {
            "maxBytes": 2048,
            "mimeTypes": [
              "text/plain"
            ],
            "directory": "products/attachments",
            "preserveExtension": true
          }
        },
        "fixtureKey": {
          "type": "string",
          "unique": true
        }
      }
    },
    "Tag": {
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "unique": true
        }
      }
    }
  },
  "deployment": {
    "docker": {
      "enabled": true,
      "nodeImage": "node:22-alpine",
      "healthcheck": true
    },
    "compose": {
      "enabled": true,
      "database": true,
      "apiPort": 3457
    },
    "kubernetes": {
      "enabled": true,
      "directory": "deploy/k8s",
      "image": "j2e-postgres-e2e:latest",
      "replicas": 2,
      "serviceType": "ClusterIP",
      "servicePort": 80,
      "resources": {
        "requests": {
          "cpu": "50m",
          "memory": "64Mi"
        },
        "limits": {
          "cpu": "500m",
          "memory": "256Mi"
        }
      }
    }
  },
  "sdk": {
    "enabled": true,
    "outputDir": "sdk",
    "languages": [
      "javascript",
      "typescript"
    ],
    "packageName": "j2e-postgres-e2e-client",
    "private": true,
    "baseUrl": "http://127.0.0.1:3457",
    "includeCustomEndpoints": true
  },
  "admin": {
    "enabled": true,
    "outputDir": "admin",
    "title": "PostgreSQL E2E Admin",
    "baseUrl": "http://127.0.0.1:3457",
    "devPort": 4173,
    "includeCustomActions": true,
    "auth": {
      "tokenStorage": "sessionStorage",
      "tokenKey": "j2e-e2e-admin-token"
    },
    "theme": {
      "brandColor": "#0f766e",
      "mode": "system"
    },
    "entities": {
      "Product": {
        "label": "Product",
        "pluralLabel": "Products",
        "titleField": "name",
        "listFields": [
          "name",
          "price",
          "category",
          "published",
          "tags",
          "image"
        ],
        "filterFields": [
          "name",
          "price",
          "category",
          "tags"
        ],
        "pageSize": 10,
        "fields": {
          "name": {
            "label": "Product name",
            "placeholder": "Keyboard"
          },
          "price": {
            "label": "Price"
          },
          "category": {
            "label": "Category",
            "widget": "reference"
          },
          "published": {
            "label": "Published",
            "widget": "checkbox"
          },
          "tags": {
            "label": "Tags",
            "widget": "reference"
          },
          "image": {
            "label": "Image",
            "widget": "file",
            "help": "Text fixture used by storage E2E"
          },
          "attachments": {
            "label": "Attachments",
            "widget": "file"
          }
        }
      },
      "Category": {
        "label": "Category",
        "pluralLabel": "Categories",
        "titleField": "name",
        "listFields": [
          "name"
        ]
      },
      "Tag": {
        "label": "Tag",
        "pluralLabel": "Tags",
        "titleField": "name",
        "listFields": [
          "name"
        ]
      }
    }
  },
  "events": {
    "product.published": {
      "webhooks": []
    },
    "product.repriced": {
      "webhooks": []
    }
  },
  "workflows": {
    "publishProduct": {
      "transaction": true,
      "steps": [
        {
          "name": "load",
          "action": "findById",
          "entity": "Product",
          "id": "$params.id"
        },
        {
          "name": "update",
          "action": "updateById",
          "entity": "Product",
          "id": "$params.id",
          "data": {
            "published": true
          }
        },
        {
          "name": "event",
          "action": "emit",
          "event": "product.published",
          "payload": {
            "id": "$steps.update.id",
            "published": "$steps.update.published"
          }
        },
        {
          "name": "response",
          "action": "respond",
          "status": 200,
          "body": {
            "id": "$steps.update.id",
            "published": "$steps.update.published"
          }
        }
      ]
    },
    "repriceProduct": {
      "transaction": true,
      "steps": [
        {
          "name": "update",
          "action": "updateById",
          "entity": "Product",
          "id": "$body.id",
          "data": {
            "price": "$body.price"
          }
        },
        {
          "name": "event",
          "action": "emit",
          "event": "product.repriced",
          "payload": {
            "id": "$steps.update.id",
            "price": "$steps.update.price"
          }
        }
      ]
    },
    "queueReprice": {
      "steps": [
        {
          "name": "job",
          "action": "enqueue",
          "job": "repriceProduct",
          "payload": {
            "id": "$params.id",
            "price": "$body.price"
          },
          "delayMs": 50
        },
        {
          "name": "response",
          "action": "respond",
          "status": 202,
          "body": {
            "queued": true
          }
        }
      ]
    }
  },
  "endpoints": {
    "publishProduct": {
      "method": "post",
      "path": "/products/:id/publish",
      "workflow": "publishProduct",
      "status": 200,
      "auth": {
        "required": true,
        "roles": [
          "admin"
        ],
        "strategies": [
          "apiKey"
        ]
      }
    },
    "queueReprice": {
      "method": "post",
      "path": "/products/:id/reprice",
      "workflow": "queueReprice",
      "status": 202
    }
  },
  "outbox": {
    "worker": "embedded",
    "pollIntervalMs": 50,
    "batchSize": 10,
    "lockTimeoutMs": 5000,
    "maxAttempts": 3,
    "backoffMs": 50
  },
  "jobs": {
    "repriceProduct": {
      "workflow": "repriceProduct",
      "queue": "products",
      "maxAttempts": 3,
      "backoffMs": 50
    }
  },
  "api": {
    "rest": true,
    "graphql": {
      "enabled": true,
      "path": "/graphql"
    }
  },
  "auth": {
    "enabled": true,
    "strategies": [
      "jwt",
      "apiKey",
      "session",
      "oidc"
    ],
    "jwt": {
      "secretEnv": "JWT_SECRET",
      "algorithms": [
        "HS256"
      ],
      "accessTtlSeconds": 300,
      "refresh": {
        "enabled": true,
        "path": "/auth/refresh",
        "ttlSeconds": 3600,
        "cookieName": "j2e_refresh",
        "returnToken": true
      }
    },
    "apiKey": {
      "header": "x-api-key",
      "keys": [
        {
          "env": "E2E_API_KEY",
          "userId": "ci-service",
          "roles": [
            "admin"
          ]
        },
        {
          "env": "E2E_VIEWER_API_KEY",
          "userId": "ci-viewer",
          "roles": [
            "viewer"
          ]
        }
      ]
    },
    "session": {
      "cookieName": "j2e_session",
      "ttlSeconds": 3600,
      "secure": false,
      "sameSite": "lax",
      "path": "/"
    },
    "local": {
      "enabled": true,
      "allowRegistration": true,
      "defaultRoles": [
        "admin"
      ],
      "passwordMinLength": 8,
      "registerPath": "/auth/register",
      "loginPath": "/auth/login",
      "logoutPath": "/auth/logout",
      "forgotPasswordPath": "/auth/forgot-password",
      "resetPasswordPath": "/auth/reset-password",
      "passwordReset": {
        "ttlSeconds": 600,
        "exposeToken": true
      }
    },
    "oidc": {
      "enabled": true,
      "issuer": "http://127.0.0.1:4568",
      "audience": "j2e-e2e-client",
      "clientIdEnv": "OIDC_CLIENT_ID",
      "rolesClaim": "roles",
      "scopes": [
        "openid",
        "profile",
        "email"
      ],
      "loginPath": "/auth/oidc/login",
      "callbackPath": "/auth/oidc/callback"
    }
  },
  "observability": {
    "enabled": true,
    "logging": {
      "enabled": true,
      "level": "info",
      "format": "json",
      "requestIds": true
    },
    "metrics": {
      "enabled": true,
      "path": "/metrics",
      "collectDefaultMetrics": true,
      "prefix": "j2e_"
    },
    "tracing": {
      "enabled": true,
      "serviceName": "j2e-postgres-e2e",
      "exporter": "console",
      "sampleRate": 1
    },
    "health": {
      "liveness": {
        "enabled": true,
        "path": "/health/live"
      },
      "readiness": {
        "enabled": true,
        "path": "/health/ready",
        "database": true,
        "outbox": true
      }
    }
  },
  "cache": {
    "enabled": true,
    "provider": "redis",
    "defaultTtlSeconds": 120,
    "prefix": "j2e:pg:e2e:",
    "varyByAuth": true,
    "redis": {
      "urlEnv": "REDIS_URL",
      "connectTimeoutMs": 3000
    }
  },
  "storage": {
    "enabled": true,
    "provider": "local",
    "signedUrls": {
      "enabled": true,
      "expiresSeconds": 300,
      "path": "/files/:token",
      "signingSecretEnv": "FILE_SIGNING_SECRET"
    },
    "local": {
      "directory": "uploads"
    }
  },
  "fixtures": {
    "Product": [
      {
        "where": {
          "fixtureKey": "fixture-prod-1"
        },
        "data": {
          "fixtureKey": "fixture-prod-1",
          "name": "Fixture Product",
          "price": 25,
          "category": {
            "where": {
              "name": "Fixture Category"
            }
          }
        }
      }
    ],
    "Category": [
      {
        "where": {
          "name": "Fixture Category"
        },
        "data": {
          "name": "Fixture Category"
        }
      }
    ]
  }
}
