{
  "specVersion": "1.0",
  "generation": {
    "outputDir": ".tmp/e2e-s3"
  },
  "app": {
    "name": "j2e-s3-e2e",
    "port": 3458,
    "host": "127.0.0.1",
    "apiPrefix": "/api",
    "health": {
      "enabled": true,
      "path": "/health",
      "status": 200,
      "response": {
        "status": "ok"
      }
    }
  },
  "database": {
    "type": "mongodb",
    "uriEnv": "MONGODB_URI",
    "defaultUri": "mongodb://127.0.0.1:27017/j2e_s3"
  },
  "storage": {
    "enabled": true,
    "provider": "s3",
    "signedUrls": {
      "enabled": true,
      "expiresSeconds": 300
    },
    "s3": {
      "bucketEnv": "S3_BUCKET",
      "regionEnv": "AWS_REGION",
      "endpointEnv": "S3_ENDPOINT",
      "accessKeyEnv": "S3_ACCESS_KEY",
      "secretKeyEnv": "S3_SECRET_KEY",
      "forcePathStyle": true
    }
  },
  "entities": {
    "Asset": {
      "fields": {
        "name": {
          "type": "string",
          "required": true
        },
        "file": {
          "type": "file",
          "required": true,
          "upload": {
            "maxBytes": 2048,
            "mimeTypes": [
              "text/plain"
            ],
            "directory": "assets/files",
            "preserveExtension": true
          }
        }
      }
    }
  }
}
