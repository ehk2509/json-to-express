{
  "name": "json-to-express",
  "version": "0.2.0-beta.6",
  "description": "Generate runnable Express or native Fastify APIs from declarative JSON, with MongoDB/Mongoose or PostgreSQL/Prisma.",
  "main": "src/index.js",
  "bin": {
    "json-to-express": "bin/json-to-express.js",
    "j2e": "bin/json-to-express.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "validate:examples": "node bin/json-to-express.js validate examples/shop.json && node bin/json-to-express.js validate examples/e2e.json && node bin/json-to-express.js validate examples/e2e-postgres.json && node bin/json-to-express.js validate examples/e2e-s3.json",
    "test:package": "node scripts/verify-package.js",
    "check:release": "node scripts/release-metadata.js check",
    "check:p9": "node scripts/p9-contract-check.js",
    "test:p9-consumers": "node scripts/p9-consumer-contract.js"
  },
  "keywords": [
    "express",
    "generator",
    "json",
    "rest-api",
    "mongoose",
    "scaffolding",
    "prisma",
    "postgresql",
    "fastify",
    "api-generator",
    "code-generation",
    "backend",
    "mongodb",
    "object-storage",
    "plugin-registry",
    "plugin-api",
    "community-plugins"
  ],
  "author": "Elyes Hkiri",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "examples",
    "scripts",
    "README.md",
    "LICENSE",
    "templates",
    "docs",
    "registry",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehk2509/json-to-express.git"
  },
  "homepage": "https://github.com/ehk2509/json-to-express#readme",
  "bugs": {
    "url": "https://github.com/ehk2509/json-to-express/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
